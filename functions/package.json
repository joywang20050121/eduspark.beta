{
  "name": "eduspark-functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "firebase emulators:start --config ../firebase.json --project demo-eduspark",
    "test": "npm run build && node --test lib/firestore.rules.test.js",
    "test:rules": "firebase emulators:exec --project demo-eduspark --only firestore \"npm test\"",
    "test:functions": "npm run build && firebase emulators:exec --project demo-eduspark --only auth,functions,firestore \"npm run test:functions:run\"",
    "test:functions:run": "node --test lib/functions.integration.test.js",
    "admin:set": "node scripts/set-admin.mjs"
  },
  "dependencies": {
    "firebase-admin": "14.3.0",
    "firebase-functions": "7.3.2",
    "qrcode": "1.5.4",
    "sanitize-html": "2.17.7"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/sanitize-html": "^2.16.0",
    "firebase": "12.18.0",
    "firebase-tools": "^14.0.0",
    "typescript": "7.0.2"
  }
}
